# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =========================================================================
# CONFIGURAÇÃO DO FIREBASE FIRESTORE • TJRJ DIGRA (Coleção: links-central)
# =========================================================================
# Copie estas variáveis para o seu arquivo .env local ou configure nas
# variáveis de ambiente da Vercel (Project Settings > Environment Variables).
VITE_FIREBASE_API_KEY="sua-api-key-aqui"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-id"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="seu-messaging-sender-id"
VITE_FIREBASE_APP_ID="seu-app-id"
